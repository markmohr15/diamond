# Flutter/Dart
app/.dart_tool/
app/build/
app/.flutter-plugins*
app/ios/Pods/
app/android/.gradle/
*.g.dart
*.freezed.dart
# Drift's own generated code is required to compile (app_database.dart has
# `part 'app_database.g.dart'`) — Drift's convention is to commit it.
!app/lib/**/*.g.dart

# Node
node_modules/
server/dist/
*.log

# Codegen output is committed (drift-checked in CI) — do NOT ignore generated types.

# OS/editor
.DS_Store
.idea/
*.iml
