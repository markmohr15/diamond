{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diamond.app/schema/events/runner_advance.schema.json",
  "title": "RunnerAdvance",
  "description": "spec §4.3. from 0 = batter's box; to 4 = scored. from==to records surviving a play (e.g., rundown) attributed to a misplay.",
  "type": "object",
  "properties": {
    "runnerId": { "type": "string" },
    "from":     { "type": "integer", "minimum": 0, "maximum": 3 },
    "to":       { "type": "integer", "minimum": 1, "maximum": 4 },
    "reason": {
      "enum": ["batted_ball", "walk", "hbp", "stolen_base", "wild_pitch", "passed_ball",
               "balk", "illegal_pitch", "error", "fielders_choice", "defensive_indifference",
               "dropped_third_strike", "catcher_interference", "obstruction", "wild_throw",
               "ground_rule", "awarded"]
    },
    "enabledByTouchId": { "type": "string", "description": "FielderTouch that enabled this advance (§13.1)" },
    "enabledByCallId":  { "type": "string", "description": "RuleCall that awarded this advance (§4.5)" }
  },
  "required": ["runnerId", "from", "to", "reason"],
  "additionalProperties": false
}
