{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diamond.app/schema/events/runner_out.schema.json",
  "title": "RunnerOut",
  "description": "spec §4.3.",
  "type": "object",
  "properties": {
    "runnerId": { "type": "string" },
    "atBase":   { "type": "integer", "minimum": 1, "maximum": 4 },
    "how": {
      "enum": ["force", "tag", "caught_stealing", "picked_off", "fly_out", "strikeout",
               "strikeout_d3k_throw", "appeal", "interference", "batted_ball_contact",
               "left_early", "look_back_rule", "abandoned", "infield_fly", "batter_out_of_box"]
    },
    "putoutTouchId":   { "type": "string", "description": "FielderTouch credited with the putout" },
    "enabledByCallId": { "type": "string" }
  },
  "required": ["runnerId", "atBase", "how"],
  "additionalProperties": false
}
